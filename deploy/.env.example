# Valores de produção — copie para deploy/.env NO SERVIDOR e preencha.
# deploy/.env nunca é versionado (está no .gitignore) e nunca entra na imagem (FR-004).
# Nada de segredo em texto no repositório, em log ou em commit (S8, A7).
#
# Obs.: não existem mais variáveis de TLS/host aqui. O certificado e o endereço são da camada de rede
# privada (Tailscale) — ver docs/adr/0005-acesso-por-rede-privada.md.

# Trello (as mesmas credenciais que o app usa; ver o README)
TRELLO_API_KEY=
TRELLO_TOKEN=

# Autenticação do app de usuário único.
# Pode ficar vazio: o app cria o hash no primeiro acesso (fica no volume app_data).
APP_PASSWORD_HASH=
SESSION_SECRET=

# Provedor de IA (preparado, sem uso em tempo de execução hoje)
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Obs.: COOKIE_SECURE não vai aqui — o compose fixa "true" em produção (S3/S7).

