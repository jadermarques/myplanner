# Segredo TOTP em base32 — gerar com: python -c "import pyotp; print(pyotp.random_base32())"
APP_TOTP_SECRET=
SESSION_SECRET=

# Provedor de IA (reservado para uso futuro; não usado nesta versão)
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
